{
  "name": "material-symbols-rc",
  "version": "1.1.1",
  "description": "Use Material Symbols in react with ease 😮‍💨! ",
  "keywords": [
    "react material symbols",
    "material symbols"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/_package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./css": "./dist/styles.css"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "npm run lint && npx vite",
    "build": "npx rimraf dist && npm run lint && npx tsc && npx vite build",
    "test": "echo Testing ...",
    "lint": "npx eslint . --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/nekomiclub/material-symbols-rc#readme",
  "bugs": {
    "url": "https://github.com/nekomiclub/material-symbols-rc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekomiclub/material-symbols-rc.git"
  },
  "dependencies": {
    "material-symbols": "^0.40.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-path": "^2.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rimraf": "^6.1.3",
    "sass": "^1.90.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4"
  }
}