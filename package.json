{
  "name": "material-symbols-rc",
  "version": "1.1.1",
  "description": "Package that adds Material Symbols into your react app!",
  "keywords": [],
  "homepage": "https://github.com/nekomiclub/material-symbols-rc#readme",
  "bugs": {
    "url": "https://github.com/nekomiclub/material-symbols-rc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekomiclub/material-symbols-rc.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./css": "./dist/styles.css"
  },
  "main": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "npx eslint . --fix --ext .ts,.tsx && npx vite",
    "build": "npx tsc && npx vite build"
  },
  "dependencies": {
    "material-symbols": "^0.40.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "eslint": "^9.32.0",
    "eslint-plugin-path": "^2.0.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sass": "^1.90.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.es.js"
